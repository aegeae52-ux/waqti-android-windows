{
  "name": "waqti-desktop",
  "version": "1.0.0",
  "description": "Waqti - Student time manager",
  "author": "Waqti",
  "main": "main.js",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.aegeae52.waqti",
    "productName": "Waqti",
    "directories": { "output": "dist" },
    "files": ["main.js", "app/**/*"],
    "win": { "icon": "build/icon.png", "target": ["nsis", "portable"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Waqti-Setup-${version}.${ext}"
    },
    "portable": { "artifactName": "Waqti-Portable-${version}.${ext}" }
  }
}
